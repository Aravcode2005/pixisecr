<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%=pageTitle%></title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;image-rendering:pixelated;}
:root{
  --pink:#FF6EB4;--pink-d:#8B2252;--pink-glow:rgba(255,110,180,0.4);
  --cyan:#00E5FF;--cyan-d:#006080;
  --purple:#B39DDB;--purple-d:#4A148C;
  --gold:#FFD54F;--gold-d:#8B6914;
  --bg:#060114;--panel:#0D0221;
  --green:#69FF47;
}
body{
  font-family:'Press Start 2P',monospace;
  background:var(--bg);
  min-height:100vh;
  display:flex;align-items:center;justify-content:center;
  padding:20px;
  position:relative;overflow:hidden;
}
#stars{position:fixed;inset:0;z-index:0;pointer-events:none;}
.s{position:absolute;background:#fff;border-radius:0;}
.bg-grid{
  position:fixed;inset:0;z-index:0;
  background:
    linear-gradient(rgba(0,229,255,0.07) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,229,255,0.07) 1px,transparent 1px);
  background-size:32px 32px;
  animation:scrollGrid 18s linear infinite;
  pointer-events:none;
}
@keyframes scrollGrid{from{background-position:0 0;}to{background-position:32px 32px;}}
.petal{
  position:fixed;z-index:1;pointer-events:none;
  width:6px;height:6px;
  animation:petalFall linear infinite;
  opacity:0;
}
@keyframes petalFall{
  0%{transform:translateY(-40px) rotate(0deg);opacity:0;}
  10%{opacity:0.85;}90%{opacity:0.5;}
  100%{transform:translateY(110vh) rotate(720deg);opacity:0;}
}
.moon{
  position:fixed;top:24px;right:64px;z-index:2;
  width:4px;height:4px;background:var(--gold);
  box-shadow:4px 0 0 var(--gold),8px 0 0 var(--gold),12px 0 0 var(--gold),
    0 4px 0 var(--gold),4px 4px 0 var(--gold),8px 4px 0 var(--gold),12px 4px 0 var(--gold),16px 4px 0 var(--gold),
    0 8px 0 var(--gold),4px 8px 0 var(--gold),8px 8px 0 var(--gold),12px 8px 0 var(--gold),16px 8px 0 var(--gold),20px 8px 0 var(--gold),
    -4px 12px 0 var(--gold),0 12px 0 var(--gold),4px 12px 0 var(--gold),8px 12px 0 var(--gold),12px 12px 0 var(--gold),16px 12px 0 var(--gold),20px 12px 0 var(--gold),
    -4px 16px 0 var(--gold),0 16px 0 var(--gold),4px 16px 0 var(--gold),8px 16px 0 var(--gold),12px 16px 0 var(--gold),16px 16px 0 var(--gold),
    0 20px 0 var(--gold),4px 20px 0 var(--gold),8px 20px 0 var(--gold),12px 20px 0 var(--gold);
  animation:moonGlow 3s ease-in-out infinite;
}
@keyframes moonGlow{0%,100%{filter:brightness(1);}50%{filter:brightness(1.5) drop-shadow(0 0 10px var(--gold));}}
.tree{position:fixed;bottom:0;z-index:2;width:100px;opacity:0.8;}
.tree-l{left:0;}
.tree-r{right:0;transform:scaleX(-1);}
.bolt{
  position:fixed;z-index:2;pointer-events:none;
  font-size:20px;color:var(--cyan);
  text-shadow:0 0 10px var(--cyan),0 0 20px var(--cyan);
  animation:boltFlash 4s ease-in-out infinite;opacity:0;
}
@keyframes boltFlash{0%,85%,100%{opacity:0;}87%{opacity:1;}90%{opacity:0.3;}92%{opacity:0.9;}95%{opacity:0;}}
.wrapper{position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;}
.statusbar{
  width:100%;max-width:480px;
  display:flex;justify-content:space-between;align-items:center;
  padding:8px 14px;
  border:2px solid rgba(0,229,255,0.3);
  background:rgba(0,229,255,0.04);
  font-size:5px;margin-bottom:0;
}
.dot{width:7px;height:7px;background:var(--green);box-shadow:0 0 6px var(--green);display:inline-block;margin-right:6px;animation:blinkDot 1s step-end infinite;}
@keyframes blinkDot{50%{opacity:0;}}
.online{color:var(--green);text-shadow:0 0 6px var(--green);}
.build{color:rgba(0,229,255,0.55);}
.panel{
  width:100%;max-width:480px;
  background:rgba(13,2,33,0.95);
  border:4px solid var(--pink);
  box-shadow:0 0 0 4px var(--bg),0 0 0 8px var(--purple),0 0 60px rgba(255,110,180,0.2),inset 0 0 40px rgba(255,110,180,0.04);
  padding:40px 36px 32px;
  position:relative;
  animation:panelPulse 4s ease-in-out infinite;
}
@keyframes panelPulse{
  0%,100%{box-shadow:0 0 0 4px var(--bg),0 0 0 8px var(--purple),0 0 40px rgba(255,110,180,0.15),inset 0 0 30px rgba(255,110,180,0.04);}
  50%{box-shadow:0 0 0 4px var(--bg),0 0 0 8px var(--pink),0 0 80px rgba(255,110,180,0.35),inset 0 0 40px rgba(255,110,180,0.09);}
}
.corner{position:absolute;width:14px;height:14px;background:var(--cyan);}
.corner.tl{top:-4px;left:-4px;}.corner.tr{top:-4px;right:-4px;}
.corner.bl{bottom:-4px;left:-4px;}.corner.br{bottom:-4px;right:-4px;}
.chibi{position:absolute;top:-100px;right:-10px;width:88px;height:96px;}
.logo{
  font-size:13px;color:var(--gold);text-align:center;line-height:1.8;
  text-shadow:3px 3px 0 var(--gold-d),0 0 16px rgba(255,213,79,0.7);
  margin-bottom:4px;animation:logoFlicker 5s infinite;
}
@keyframes logoFlicker{0%,90%,100%{opacity:1;}92%{opacity:0.7;}94%{opacity:1;}96%{opacity:0.6;}}
.logo-sub{font-size:5px;color:var(--pink);text-align:center;letter-spacing:3px;margin-bottom:20px;text-shadow:0 0 10px var(--pink-glow);}
.hp-row{display:flex;align-items:center;gap:6px;margin-bottom:12px;}
.hp-lbl{font-size:5px;color:var(--gold);white-space:nowrap;}
.hp-track{flex:1;height:9px;background:#1a0a2e;border:2px solid #4a2060;overflow:hidden;}
.hp-fill{height:100%;width:78%;background:repeating-linear-gradient(90deg,#FF6EB4 0px,#FF6EB4 4px,#FF85C0 4px,#FF85C0 8px);animation:hpPulse 2s steps(1) infinite;}
@keyframes hpPulse{0%,80%{opacity:1;}90%{opacity:0.55;}100%{opacity:1;}}
.divider{width:100%;height:4px;background:repeating-linear-gradient(90deg,var(--pink) 0,var(--pink) 4px,transparent 4px,transparent 8px);margin-bottom:18px;}
.mission{font-size:6px;color:rgba(179,157,219,0.9);text-align:center;line-height:2.4;margin-bottom:10px;border-left:3px solid var(--pink);border-right:3px solid var(--pink);padding:0 10px;}
.mission b{color:var(--cyan);font-weight:400;text-shadow:0 0 8px var(--cyan);}
.quest-box{border:2px solid rgba(255,213,79,0.3);background:rgba(255,213,79,0.04);padding:10px 14px;margin-bottom:20px;display:flex;align-items:center;gap:10px;}
.quest-icon{font-size:16px;}
.quest-txt{font-size:5px;color:var(--gold);line-height:2.2;}
.quest-txt span{color:rgba(179,157,219,0.7);}
.otp-section{margin-bottom:20px;}
.otp-label{font-size:6px;color:var(--cyan);letter-spacing:1px;display:block;margin-bottom:10px;text-shadow:0 0 6px rgba(0,229,255,0.5);}
.otp-boxes{display:flex;gap:10px;justify-content:center;}
.otp-digit{
  width:52px;height:60px;
  background:rgba(6,1,20,0.95);
  border:3px solid var(--purple);
  color:#fff;
  font-family:'Press Start 2P',monospace;
  font-size:18px;text-align:center;outline:none;
  transition:border-color 0.15s,box-shadow 0.15s;
  caret-color:var(--pink);
}
.otp-digit:focus{border-color:var(--pink);box-shadow:0 0 16px rgba(255,110,180,0.5),inset 0 0 10px rgba(255,110,180,0.06);}
.otp-digit.filled{border-color:var(--cyan);box-shadow:0 0 10px rgba(0,229,255,0.35);color:var(--cyan);}
.timer-row{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:20px;font-size:6px;}
.timer-icon{color:var(--gold);text-shadow:0 0 6px var(--gold);}
.timer-txt{color:rgba(179,157,219,0.7);}
.timer-val{color:var(--gold);text-shadow:0 0 8px rgba(255,213,79,0.5);}
.timer-val.danger{color:#FF4444;text-shadow:0 0 8px rgba(255,68,68,0.7);animation:dangerBlink 0.5s steps(1) infinite;}
@keyframes dangerBlink{50%{opacity:0;}}
.btn-row{display:flex;gap:12px;margin-bottom:18px;}
.btn{flex:1;font-family:'Press Start 2P',monospace;font-size:6px;padding:14px 8px;border:none;cursor:pointer;line-height:1.8;letter-spacing:0.5px;transition:transform 0.1s,filter 0.1s;position:relative;overflow:hidden;}
.btn::after{content:"";position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.25),transparent);transition:left 0.4s;}
.btn:hover::after{left:130%;}
.btn:active{transform:translate(2px,2px);}
.btn-enter{background:var(--pink);color:#0D0221;box-shadow:4px 4px 0 var(--pink-d);}
.btn-enter:hover{filter:brightness(1.2);box-shadow:4px 4px 0 var(--pink-d),0 0 20px var(--pink-glow);}
.btn-resend{background:transparent;color:var(--cyan);border:3px solid var(--cyan);box-shadow:3px 3px 0 var(--cyan-d);}
.btn-resend:hover{background:rgba(0,229,255,0.07);filter:brightness(1.15);}
.btn-resend:disabled{opacity:0.35;cursor:not-allowed;filter:none;}
.msg{font-size:5px;text-align:center;line-height:2.2;padding:8px 10px;border:2px solid transparent;margin-bottom:14px;display:none;}
.msg.error{color:#FF4444;border-color:rgba(255,68,68,0.4);background:rgba(255,68,68,0.06);}
.msg.success{color:var(--green);border-color:rgba(105,255,71,0.4);background:rgba(105,255,71,0.06);}
.msg.show{display:block;}
.foot{font-size:5px;color:rgba(179,157,219,0.4);text-align:center;line-height:2.5;border-top:2px solid rgba(255,255,255,0.05);padding-top:14px;}
.cursor{color:var(--pink);font-size:10px;animation:blink 1s steps(1) infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}
@media(max-width:520px){
  .panel{padding:28px 18px 24px;}
  .otp-digit{width:42px;height:52px;font-size:14px;}
  .chibi{display:none;}
}

/* ── Pixel loading screen ── */
.pixel-loader{position:fixed;inset:0;z-index:99999;background:var(--bg);display:flex;align-items:center;justify-content:center;transition:opacity .5s ease,visibility .5s ease;}
.pixel-loader.hide{opacity:0;visibility:hidden;pointer-events:none;}
.pl-inner{display:flex;flex-direction:column;align-items:center;gap:16px;}
.pl-sprite{display:flex;gap:6px;}
.pl-sprite span{width:10px;height:10px;animation:plBounce .9s ease-in-out infinite;}
.pl-sprite span:nth-child(1){background:var(--pink);box-shadow:0 0 8px var(--pink);animation-delay:0s;}
.pl-sprite span:nth-child(2){background:var(--cyan);box-shadow:0 0 8px var(--cyan);animation-delay:.12s;}
.pl-sprite span:nth-child(3){background:var(--gold);box-shadow:0 0 8px var(--gold);animation-delay:.24s;}
.pl-sprite span:nth-child(4){background:var(--purple);box-shadow:0 0 8px var(--purple);animation-delay:.36s;}
@keyframes plBounce{0%,60%,100%{transform:translateY(0);opacity:.6;}30%{transform:translateY(-14px);opacity:1;}}
.pl-bar{width:160px;height:8px;background:#1a0a2e;border:2px solid var(--purple);overflow:hidden;}
.pl-bar-fill{height:100%;width:0%;background:repeating-linear-gradient(90deg,var(--pink) 0,var(--pink) 4px,var(--gold) 4px,var(--gold) 8px);animation:plFill 1.3s ease-in-out infinite;}
@keyframes plFill{0%{width:0%;}50%{width:100%;}100%{width:0%;}}
.pl-text{font-family:'Press Start 2P',monospace;font-size:8px;color:var(--gold);letter-spacing:2px;text-shadow:0 0 8px rgba(255,213,79,.6);}
.pl-dots{animation:plBlink 1s steps(1) infinite;}
@keyframes plBlink{50%{opacity:0;}}
</style>
</head>
<body>

<div class="pixel-loader" id="pixelLoader">
  <div class="pl-inner">
    <div class="pl-sprite"><span></span><span></span><span></span><span></span></div>
    <div class="pl-bar"><div class="pl-bar-fill"></div></div>
    <div class="pl-text">SUMMONING SEAL<span class="pl-dots">...</span></div>
  </div>
</div>

<div id="stars"></div>
<div class="bg-grid"></div>
<div class="moon"></div>
<div id="petals"></div>
<div class="bolt" style="top:15%;left:8%;animation-delay:0s;">✦</div>
<div class="bolt" style="top:70%;right:12%;animation-delay:1.5s;">★</div>
<div class="bolt" style="top:40%;left:75%;animation-delay:3s;">◆</div>

<svg class="tree tree-l" viewBox="0 0 100 160" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="44" y="120" width="6" height="40" fill="#7B3F6E"/>
  <rect x="40" y="96" width="6" height="32" fill="#7B3F6E" transform="rotate(-8 40 96)"/>
  <rect x="48" y="90" width="6" height="36" fill="#7B3F6E" transform="rotate(6 48 90)"/>
  <rect x="6"  y="80" width="20" height="10" fill="#FF9EC0"/>
  <rect x="2"  y="86" width="10" height="10" fill="#FF9EC0"/>
  <rect x="18" y="72" width="10" height="10" fill="#FFB8D1"/>
  <rect x="28" y="66" width="20" height="10" fill="#FF9EC0"/>
  <rect x="22" y="72" width="10" height="10" fill="#FFB8D1"/>
  <rect x="40" y="58" width="20" height="10" fill="#FF9EC0"/>
  <rect x="34" y="64" width="10" height="10" fill="#FF9EC0"/>
  <rect x="58" y="50" width="20" height="10" fill="#FFB8D1"/>
  <rect x="52" y="56" width="10" height="10" fill="#FF9EC0"/>
</svg>

<svg class="tree tree-r" viewBox="0 0 100 160" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="44" y="120" width="6" height="40" fill="#7B3F6E"/>
  <rect x="40" y="96" width="6" height="32" fill="#7B3F6E" transform="rotate(-8 40 96)"/>
  <rect x="48" y="90" width="6" height="36" fill="#7B3F6E" transform="rotate(6 48 90)"/>
  <rect x="6"  y="80" width="20" height="10" fill="#FF9EC0"/>
  <rect x="2"  y="86" width="10" height="10" fill="#FF9EC0"/>
  <rect x="18" y="72" width="10" height="10" fill="#FFB8D1"/>
  <rect x="28" y="66" width="20" height="10" fill="#FF9EC0"/>
  <rect x="22" y="72" width="10" height="10" fill="#FFB8D1"/>
  <rect x="40" y="58" width="20" height="10" fill="#FF9EC0"/>
  <rect x="34" y="64" width="10" height="10" fill="#FF9EC0"/>
  <rect x="58" y="50" width="20" height="10" fill="#FFB8D1"/>
  <rect x="52" y="56" width="10" height="10" fill="#FF9EC0"/>
</svg>

<div class="wrapper">
  <div class="statusbar">
    <span class="build">✦ BUILD v0.9.7_ALPHA | SECTOR-9</span>
    <span class="online"><span class="dot"></span>SYSTEM ONLINE</span>
  </div>

  <div class="panel">
    <div class="corner tl"></div><div class="corner tr"></div>
    <div class="corner bl"></div><div class="corner br"></div>

    <!-- Chibi pixel art -->
    <svg class="chibi" viewBox="0 0 88 96" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="28" y="52" width="32" height="28" fill="#9C4FE8"/>
      <rect x="22" y="52" width="6"  height="22" fill="#7035C0"/>
      <rect x="60" y="52" width="6"  height="22" fill="#7035C0"/>
      <rect x="28" y="52" width="32" height="6"  fill="#FF6EB4"/>
      <rect x="32" y="80" width="10" height="16" fill="#9C4FE8"/>
      <rect x="46" y="80" width="10" height="16" fill="#7035C0"/>
      <rect x="28" y="94" width="16" height="4" fill="#2D1B6E"/>
      <rect x="44" y="94" width="16" height="4" fill="#2D1B6E"/>
      <rect x="28" y="8"  width="32" height="28" fill="#FFD0A8"/>
      <rect x="22" y="8"  width="6"  height="24" fill="#2D1B6E"/>
      <rect x="60" y="8"  width="6"  height="24" fill="#2D1B6E"/>
      <rect x="22" y="2"  width="44" height="10" fill="#2D1B6E"/>
      <rect x="16" y="6"  width="6"  height="6"  fill="#2D1B6E"/>
      <rect x="66" y="6"  width="6"  height="6"  fill="#2D1B6E"/>
      <rect x="32" y="20" width="6" height="6" fill="#1A0A3E"/>
      <rect x="50" y="20" width="6" height="6" fill="#1A0A3E"/>
      <rect x="30" y="18" width="10" height="3" fill="#1A0A3E"/>
      <rect x="48" y="18" width="10" height="3" fill="#1A0A3E"/>
      <rect x="36" y="30" width="10" height="3" fill="#E8907A"/>
      <rect x="29" y="22" width="4" height="4" fill="#fff" opacity="0.7"/>
      <rect x="51" y="22" width="4" height="4" fill="#fff" opacity="0.7"/>
      <rect x="66" y="40" width="4" height="4" fill="#FFD54F"/>
      <rect x="70" y="36" width="4" height="4" fill="#FFD54F"/>
      <rect x="68" y="34" width="4" height="4" fill="#FFF176" opacity="0.8"/>
    </svg>

    <div class="logo">ECHOES OF<br>OBLIVION</div>
    <div class="logo-sub">◆ LOST REALM CHRONICLES ◆</div>

    <div class="hp-row">
      <span class="hp-lbl">HERO HP</span>
      <div class="hp-track"><div class="hp-fill"></div></div>
      <span class="hp-lbl">78/100</span>
    </div>

    <div class="divider"></div>

    <p class="mission">
      A <b>sacred seal code</b> has been sent to your scroll.<br>
      Enter it to pass through the <b>shimmering gate</b>.
    </p>

    <div class="quest-box">
      <span class="quest-icon">📜</span>
      <div class="quest-txt">
        ► ACTIVE QUEST: GATE VERIFICATION<br>
        <span>Check your enchanted scroll (email)</span>
      </div>
    </div>

    <div class="msg error" id="errMsg">✖ INVALID SEAL — TRY AGAIN</div>
    <div class="msg success" id="okMsg">✔ SEAL ACCEPTED — ENTERING REALM</div>

    <form id="otpForm" method="POST" action="/verifyotp">
      <div class="otp-section">
        <span class="otp-label">► ENTER SACRED SEAL CODE</span>
        <div class="otp-boxes">
          <input class="otp-digit" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]" autocomplete="off" id="d0">
          <input class="otp-digit" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]" autocomplete="off" id="d1">
          <input class="otp-digit" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]" autocomplete="off" id="d2">
          <input class="otp-digit" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]" autocomplete="off" id="d3">
          <input class="otp-digit" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]" autocomplete="off" id="d4">
          <input class="otp-digit" maxlength="1" type="text" inputmode="numeric" pattern="[0-9]" autocomplete="off" id="d5">
        </div>
        <input type="hidden" name="otp" id="otpHidden">
      </div>

      <div class="timer-row">
        <span class="timer-icon">⧖</span>
        <span class="timer-txt">SEAL EXPIRES IN:</span>
        <span class="timer-val" id="timer">04:59</span>
      </div>

      <div class="btn-row">
        <button class="btn btn-enter" type="submit">▶ ENTER<br>THE GATE</button>
        <button class="btn btn-resend" type="button" id="resendBtn" disabled>↺ RESEND<br>SCROLL</button>
      </div>
    </form>

    <p class="foot">★ NEED HELP? SUMMON THE GUILD ★<br><span class="cursor">_</span></p>
  </div>
</div>

<script>
const sc=document.getElementById("stars");
for(let i=0;i<100;i++){
  const s=document.createElement("div");s.className="s";
  const sz=Math.random()*2+1;
  s.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${sz}px;height:${sz}px;opacity:${Math.random()};box-shadow:0 0 ${sz*2}px #fff;animation:blink ${1.5+Math.random()*3}s ${Math.random()*4}s infinite alternate;`;
  sc.appendChild(s);
}
const pc=document.getElementById("petals");
const pcolors=["#FF9EC0","#FFB8D1","#FF6EB4","#FFD0E8"];
for(let i=0;i<22;i++){
  const p=document.createElement("div");p.className="petal";
  const c=pcolors[Math.floor(Math.random()*pcolors.length)];
  p.style.cssText=`left:${Math.random()*100}%;width:${4+Math.floor(Math.random()*4)}px;height:${4+Math.floor(Math.random()*4)}px;background:${c};box-shadow:0 0 4px ${c};animation-duration:${5+Math.random()*8}s;animation-delay:${Math.random()*10}s;`;
  pc.appendChild(p);
}
const bkf=document.createElement("style");
bkf.textContent="@keyframes blink{from{opacity:0.1;}to{opacity:1;}}";
document.head.appendChild(bkf);

const digits=document.querySelectorAll(".otp-digit");
digits.forEach((d,i)=>{
  d.addEventListener("input",e=>{
    const v=e.target.value.replace(/\D/g,"");
    e.target.value=v;
    if(v&&i<digits.length-1){digits[i+1].focus();}
    updateFilled();updateHidden();
  });
  d.addEventListener("keydown",e=>{
    if(e.key==="Backspace"&&!e.target.value&&i>0){digits[i-1].focus();digits[i-1].value="";}
    if(e.key==="ArrowLeft"&&i>0)digits[i-1].focus();
    if(e.key==="ArrowRight"&&i<digits.length-1)digits[i+1].focus();
  });
  d.addEventListener("paste",e=>{
    e.preventDefault();
    const txt=(e.clipboardData||window.clipboardData).getData("text").replace(/\D/g,"");
    [...txt].slice(0,6).forEach((ch,j)=>{if(digits[i+j])digits[i+j].value=ch;});
    updateFilled();updateHidden();
    digits[Math.min(i+txt.length,5)].focus();
  });
});
function updateFilled(){digits.forEach(d=>{d.classList.toggle("filled",d.value!=="");});}
function updateHidden(){document.getElementById("otpHidden").value=[...digits].map(d=>d.value).join("");}

let seconds=299;
const tv=document.getElementById("timer");
const rb=document.getElementById("resendBtn");
function tick(){
  if(seconds<=0){tv.textContent="00:00";tv.classList.add("danger");rb.disabled=false;clearInterval(interval);return;}
  const m=Math.floor(seconds/60),s=seconds%60;
  tv.textContent=`${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
  if(seconds<=30)tv.classList.add("danger");
  seconds--;
}
tick();
let interval=setInterval(tick,1000);

rb.addEventListener("click",()=>{
  rb.disabled=true;seconds=299;
  tv.classList.remove("danger");
  const tmp=rb.innerHTML;rb.innerHTML="SENT!";
  setTimeout(()=>{rb.innerHTML=tmp;},1500);
  clearInterval(interval);interval=setInterval(tick,1000);
});

window.addEventListener('load', function () {
  var l = document.getElementById('pixelLoader');
  if (!l) return;
  setTimeout(function () {
    l.classList.add('hide');
    setTimeout(function () { l.remove(); }, 600);
  }, 350);
});
</script>
</body>
</html>
