<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= typeof pageTitle !== "undefined" ? pageTitle : "System Terminal" %></title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;image-rendering:pixelated;}
:root{
  --purple:#8b5cf6;--purple-d:#4c1d95;
  --cyan:#00e5ff;--cyan-d:#006080;
  --pink:#FF6EB4;--gold:#FFD54F;--green:#69FF47;
  --bg:#050816;--panel:#0a0c19;
}
body{
  font-family:'Press Start 2P',cursive;
  background:var(--bg);min-height:100vh;
  display:flex;align-items:center;justify-content:center;
  padding:20px;position:relative;overflow-x:hidden;overflow-y:auto;color:#fff;
}
#stars{position:fixed;inset:0;z-index:0;pointer-events:none;}
.star{position:absolute;background:#fff;}
.bg-grid{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background:linear-gradient(rgba(139,92,246,0.06) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,229,255,0.06) 1px,transparent 1px);
  background-size:40px 40px;animation:gridMove 20s linear infinite;
}
@keyframes gridMove{from{background-position:0 0;}to{background-position:40px 40px;}}
.scanlines{position:fixed;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(to bottom,rgba(255,255,255,0.03) 0,rgba(255,255,255,0.03) 1px,transparent 1px,transparent 4px);opacity:0.3;}
.orb{position:fixed;border-radius:50%;filter:blur(70px);opacity:0.35;z-index:0;}
.orb1{width:260px;height:260px;background:#8b5cf6;top:-80px;right:-80px;animation:floatOrb 8s ease-in-out infinite;}
.orb2{width:240px;height:240px;background:#00e5ff;bottom:-80px;left:-80px;animation:floatOrb 10s ease-in-out infinite reverse;}
.orb3{width:180px;height:180px;background:#FF6EB4;top:50%;left:50%;animation:floatOrbCenter 12s ease-in-out infinite;}
@keyframes floatOrb{0%,100%{transform:translateY(0);}50%{transform:translateY(20px);}}
@keyframes floatOrbCenter{0%,100%{transform:translate(-50%,-50%);}50%{transform:translate(-50%,calc(-50% + 20px));}}
.pixel-float{position:fixed;z-index:1;pointer-events:none;animation:floatUp linear infinite;opacity:0;}
@keyframes floatUp{0%{transform:translateY(100vh) rotate(0);opacity:0;}10%{opacity:0.7;}90%{opacity:0.4;}100%{transform:translateY(-20vh) rotate(540deg);opacity:0;}}
.wrapper{position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;width:100%;max-width:560px;}
.statusbar{width:100%;display:flex;justify-content:space-between;align-items:center;padding:8px 16px;font-size:5px;border:2px solid rgba(0,229,255,0.25);background:rgba(0,229,255,0.03);}
.dot{width:7px;height:7px;background:var(--green);box-shadow:0 0 6px var(--green);display:inline-block;margin-right:6px;animation:blinkDot 1s step-end infinite;}
@keyframes blinkDot{50%{opacity:0;}}
.online{color:var(--green);text-shadow:0 0 6px var(--green);}
.build-lbl{color:rgba(0,229,255,0.5);}
.panel{
  width:100%;background:rgba(10,12,25,0.92);
  border:4px solid var(--purple);
  box-shadow:0 0 0 4px var(--bg),0 0 0 8px rgba(139,92,246,0.4),0 0 60px rgba(139,92,246,0.2),inset 0 0 40px rgba(139,92,246,0.04);
  padding:44px 40px 36px;position:relative;text-align:center;
  animation:panelPulse 4s ease-in-out infinite;
}
@keyframes panelPulse{
  0%,100%{box-shadow:0 0 0 4px var(--bg),0 0 0 8px rgba(139,92,246,0.4),0 0 40px rgba(139,92,246,0.15),inset 0 0 30px rgba(139,92,246,0.03);}
  50%{box-shadow:0 0 0 4px var(--bg),0 0 0 8px rgba(0,229,255,0.4),0 0 80px rgba(0,229,255,0.2),inset 0 0 40px rgba(0,229,255,0.05);}
}
.corner{position:absolute;width:16px;height:16px;background:var(--cyan);}
.corner.tl{top:-4px;left:-4px;}.corner.tr{top:-4px;right:-4px;}
.corner.bl{bottom:-4px;left:-4px;}.corner.br{bottom:-4px;right:-4px;}
.logo{font-size:2rem;line-height:1.3;color:#fff;text-shadow:4px 4px 0 var(--purple-d),0 0 20px rgba(139,92,246,0.7),0 0 40px rgba(0,229,255,0.3);animation:logoGlitch 6s infinite;margin-bottom:6px;}
@keyframes logoGlitch{0%,90%,100%{transform:translate(0);}92%{transform:translate(-3px,1px);filter:hue-rotate(30deg);}93%{transform:translate(3px,-1px);filter:hue-rotate(-20deg);}94%{transform:translate(0);}}
.logo span{color:var(--cyan);text-shadow:3px 3px 0 var(--cyan-d),0 0 15px var(--cyan);}
.logo-sub{font-size:5px;color:var(--purple);letter-spacing:3px;margin-bottom:26px;text-shadow:0 0 8px rgba(139,92,246,0.6);}
.divider{width:100%;height:4px;background:repeating-linear-gradient(90deg,var(--purple) 0,var(--purple) 4px,transparent 4px,transparent 8px);margin-bottom:24px;}
.stats-row{display:flex;gap:12px;margin-bottom:24px;}
.stat{flex:1;background:rgba(139,92,246,0.08);border:2px solid rgba(139,92,246,0.2);padding:10px 8px;text-align:center;}
.stat-val{font-size:10px;color:var(--gold);text-shadow:0 0 8px rgba(255,213,79,0.5);display:block;margin-bottom:5px;}
.stat-lbl{font-size:4px;color:rgba(179,157,219,0.6);}
.hp-row{display:flex;align-items:center;gap:8px;margin-bottom:24px;}
.hp-lbl{font-size:5px;color:var(--gold);white-space:nowrap;}
.hp-track{flex:1;height:10px;background:#1a0a2e;border:2px solid #4a2060;overflow:hidden;}
.hp-fill{height:100%;width:87%;background:repeating-linear-gradient(90deg,#8b5cf6 0,#8b5cf6 4px,#a87cff 4px,#a87cff 8px);animation:hpPulse 2.5s steps(1) infinite;}
@keyframes hpPulse{0%,80%{opacity:1;}88%{opacity:0.5;}100%{opacity:1;}}
.cmd-label{font-size:6px;color:var(--cyan);letter-spacing:1px;margin-bottom:16px;display:block;text-shadow:0 0 6px rgba(0,229,255,0.4);}
.btn-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.action-form{margin:0;}
.action-form .game-btn,.action-form .btn-ghost{width:100%;height:100%;}
.game-btn{font-family:'Press Start 2P',cursive;font-size:7px;padding:20px 12px;border:none;cursor:pointer;line-height:1.9;letter-spacing:0.5px;position:relative;overflow:hidden;transition:transform 0.1s,filter 0.1s;text-align:center;}
.game-btn::after{content:"";position:absolute;top:0;left:-110%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.3),transparent);transition:left 0.4s;}
.game-btn:hover::after{left:120%;}
.game-btn:hover{transform:translateY(-5px);}
.game-btn:active{transform:translate(3px,3px);}
.btn-profile{background:var(--purple);color:#fff;box-shadow:5px 5px 0 var(--purple-d),0 0 20px rgba(139,92,246,0.5);}
.btn-profile:hover{box-shadow:5px 5px 0 var(--purple-d),0 0 35px rgba(139,92,246,0.8);}
.btn-game{background:var(--cyan);color:#041018;box-shadow:5px 5px 0 var(--cyan-d),0 0 20px rgba(0,229,255,0.5);}
.btn-game:hover{box-shadow:5px 5px 0 var(--cyan-d),0 0 35px rgba(0,229,255,0.8);}
.btn-icon{display:block;font-size:18px;margin-bottom:8px;}
.btn-secondary-row{display:grid;grid-template-columns:1fr;gap:12px;margin-bottom:24px;}
.btn-ghost{font-family:'Press Start 2P',cursive;font-size:5px;padding:12px 8px;background:transparent;cursor:pointer;line-height:1.9;position:relative;overflow:hidden;transition:transform 0.1s;}
.btn-ghost:hover{transform:translateY(-3px);}
.btn-ghost:active{transform:translate(2px,2px);}
.btn-items{color:var(--gold);border:2px solid var(--gold);box-shadow:3px 3px 0 #7a6b00;}
.btn-items:hover{background:rgba(255,213,79,0.07);}
.btn-logout{color:#FF4444;border:2px solid #FF4444;box-shadow:3px 3px 0 #7a0000;}
.btn-logout:hover{background:rgba(255,68,68,0.07);}
.btn-start{color:var(--green);border:2px solid var(--green);box-shadow:3px 3px 0 #1f7a00;}
.btn-start:hover{background:rgba(105,255,71,0.07);}
.terminal-line{font-size:5px;color:rgba(0,229,255,0.5);text-align:left;margin-bottom:20px;border:2px solid rgba(0,229,255,0.1);background:rgba(0,229,255,0.03);padding:10px 14px;line-height:2.4;}
.t-green{color:var(--green);}.t-purple{color:var(--purple);}.t-gold{color:var(--gold);}
.cursor-blink{animation:blink 1s steps(1) infinite;color:var(--cyan);}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}
.footer{font-size:5px;color:rgba(140,150,214,0.45);line-height:2.4;border-top:2px solid rgba(255,255,255,0.05);padding-top:14px;}
@media(max-width:480px){
  body{align-items:flex-start;padding:14px;}
  .statusbar{gap:10px;flex-wrap:wrap;justify-content:center;text-align:center;}
  .panel{padding:28px 18px 24px;}
  .logo{font-size:1.4rem;}
  .logo-sub{letter-spacing:1px;line-height:2;}
  .btn-grid,.btn-secondary-row{grid-template-columns:1fr;}
  .stats-row{flex-direction:column;gap:8px;}
}


.pixel-loader{position:fixed;inset:0;z-index:99999;background:var(--bg);display:flex;align-items:center;justify-content:center;transition:opacity .5s ease,visibility .5s ease;}
.pixel-loader.hide{opacity:0;visibility:hidden;pointer-events:none;}
.pl-inner{display:flex;flex-direction:column;align-items:center;gap:16px;}
.pl-sprite{display:flex;gap:6px;}
.pl-sprite span{width:10px;height:10px;animation:plBounce .9s ease-in-out infinite;}
.pl-sprite span:nth-child(1){background:var(--purple);box-shadow:0 0 8px var(--purple);animation-delay:0s;}
.pl-sprite span:nth-child(2){background:var(--cyan);box-shadow:0 0 8px var(--cyan);animation-delay:.12s;}
.pl-sprite span:nth-child(3){background:var(--gold);box-shadow:0 0 8px var(--gold);animation-delay:.24s;}
.pl-sprite span:nth-child(4){background:var(--pink);box-shadow:0 0 8px var(--pink);animation-delay:.36s;}
@keyframes plBounce{0%,60%,100%{transform:translateY(0);opacity:.6;}30%{transform:translateY(-14px);opacity:1;}}
.pl-bar{width:160px;height:8px;background:#10081f;border:2px solid var(--purple);overflow:hidden;}
.pl-bar-fill{height:100%;width:0%;background:repeating-linear-gradient(90deg,var(--purple) 0,var(--purple) 4px,var(--cyan) 4px,var(--cyan) 8px);animation:plFill 1.3s ease-in-out infinite;}
@keyframes plFill{0%{width:0%;}50%{width:100%;}100%{width:0%;}}
.pl-text{font-family:'Press Start 2P',cursive;font-size:8px;color:var(--gold);letter-spacing:2px;text-shadow:0 0 8px rgba(255,213,79,.6);}
.pl-dots{animation:plBlink 1s steps(1) infinite;}
@keyframes plBlink{50%{opacity:0;}}
</style>
</head>
<body>

<div class="pixel-loader" id="pixelLoader">
  <div class="pl-inner">
    <div class="pl-sprite"><span></span><span></span><span></span><span></span></div>
    <div class="pl-bar"><div class="pl-bar-fill"></div></div>
    <div class="pl-text">LINKING NEURAL NET<span class="pl-dots">...</span></div>
  </div>
</div>

<div id="stars"></div>
<div class="bg-grid"></div>
<div class="scanlines"></div>
<div class="orb orb1"></div>
<div class="orb orb2"></div>
<div class="orb orb3"></div>
<div id="floaters"></div>

<div class="wrapper">
  <div class="statusbar">
    <span class="build-lbl">✦ NEURAL LINK v0.9.7 | SECTOR-9</span>
    <span class="online"><span class="dot"></span>CONNECTED</span>
  </div>

  <div class="panel">
    <div class="corner tl"></div><div class="corner tr"></div>
    <div class="corner bl"></div><div class="corner br"></div>

    <div class="logo">SYSTEM<br><span>TERMINAL</span></div>
    <div class="logo-sub">◆ ECHOES OF OBLIVION — LOST REALM CHRONICLES ◆</div>

    <div class="stats-row">
      <div class="stat">
        <span class="stat-val">LV.42</span>
        <span class="stat-lbl">HERO RANK</span>
      </div>
      <div class="stat">
        <span class="stat-val">6,200</span>
        <span class="stat-lbl">XP TOTAL</span>
      </div>
      <div class="stat">
        <span class="stat-val">★ 19</span>
        <span class="stat-lbl">RELICS</span>
      </div>
    </div>

    <div class="hp-row">
      <span class="hp-lbl">HP</span>
      <div class="hp-track"><div class="hp-fill"></div></div>
      <span class="hp-lbl">87/100</span>
    </div>
    <div class="divider"></div>
    <span class="cmd-label">► SELECT COMMAND</span>
    <div class="btn-grid">
      <button class="game-btn btn-profile" type="button" onclick='window.location.href="/profile"'>
        <span class="btn-icon">👤</span>
        ► PROFILE<br>DOSSIER
      </button>
      <button class="game-btn btn-game" type="button" onclick='window.location.href="/mainScene"'>
        <span class="btn-icon">⚔️</span>
        ► ENTER<br>REALM
      </button>
    </div>

    <form method="POST" action="/user" name="disconnect" class="action-form">
      <div class="btn-secondary-row">
        <button class="btn-ghost btn-logout" name="disconnect" value="true" type="submit">✖ DISCONNECT</button>
      </div>
    </form>
    <div class="terminal-line" id="termLog">
      <span class="t-green">■</span> NEURAL LINK ESTABLISHED...<br>
      <span class="t-purple">■</span> HERO SYNC: <span class="t-gold">COMPLETE</span><br>
      <span class="t-green">■</span> REALM STATUS: ACTIVE<br>
      <span class="t-purple">■</span> AWAITING COMMAND INPUT<span class="cursor-blink"> _</span>
    </div>
    <div class="footer">★ SYSTEM ONLINE • ECHO PROTOCOL 2089 ★</div>
  </div>
</div>

<script>
const sc=document.getElementById("stars");
for(let i=0;i<110;i++){
  const s=document.createElement("div");s.className="star";
  const sz=Math.random()*2.5+0.5;
  s.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${sz}px;height:${sz}px;opacity:${Math.random()};box-shadow:0 0 ${sz*2}px #fff;animation:starTwinkle ${1.5+Math.random()*3}s ${Math.random()*4}s infinite alternate;`;
  sc.appendChild(s);
}
const fc=document.getElementById("floaters");
const cols=["#8b5cf6","#00e5ff","#FF6EB4","#FFD54F","#69FF47"];
for(let i=0;i<16;i++){
  const p=document.createElement("div");p.className="pixel-float";
  const sz=Math.floor(Math.random()*8+4);
  const c=cols[Math.floor(Math.random()*cols.length)];
  p.style.cssText=`left:${Math.random()*100}%;width:${sz}px;height:${sz}px;background:${c};box-shadow:0 0 ${sz}px ${c};animation-duration:${7+Math.random()*10}s;animation-delay:${Math.random()*10}s;`;
  fc.appendChild(p);
}
const bkf=document.createElement("style");
bkf.textContent="@keyframes starTwinkle{from{opacity:0.08;}to{opacity:1;}}";
document.head.appendChild(bkf);

const logs=["SCANNING DIMENSIONAL RIFT...","LOADING HERO INVENTORY...","CALIBRATING RELIC ENERGY...","SYNCING REALM COORDINATES...","DETECTING ENTITY SIGNATURES...","REALM BREACH DETECTED...","POWER LEVEL: OVER 9000..."];
let li=0;
setInterval(()=>{
  const log=document.getElementById("termLog");
  const msg=logs[li%logs.length];li++;
  const c=["t-green","t-purple","t-gold"][Math.floor(Math.random()*3)];
  log.innerHTML+=`<br><span class="${c}">■</span> ${msg}<span class="cursor-blink"> _</span>`;
  const parts=log.innerHTML.split("<br>");
  if(parts.length>10)log.innerHTML=parts.slice(-8).join("<br>");
},3200);

window.addEventListener('load', function () {
  var l = document.getElementById('pixelLoader');
  if (!l) return;
  setTimeout(function () {
    l.classList.add('hide');
    setTimeout(function () { l.remove(); }, 600);
  }, 350);
});
</script>
</body>
</html>
